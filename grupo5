import streamlit as st
import pandas as pd

st.set_page_config(
    page_title="Monitor de Desigualdad EPH - Corrientes (Grupo 5)",
    layout="wide",
    initial_sidebar_state="expanded",
)

GINI = {"T4 2024": 0.3305706743, "T4 2025": 0.3358053924}
